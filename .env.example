# MySQL Configuration
MYSQL_ROOT_PASSWORD=your_root_password_here
MYSQL_DATABASE=your_database_name_here
MYSQL_USER=your_user_here
MYSQL_PASSWORD=your_password_here

# JWT
JWT_SECRET=your-secret-key-change-in-production

# Public application URL (used in password reset links)
FRONTEND_URL=http://localhost:3000

# Local SMTP (replace these values with your provider credentials on the VPS)
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=EventManager <no-reply@eventmanager.local>
