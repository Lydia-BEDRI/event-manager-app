# MySQL Configuration
MYSQL_ROOT_PASSWORD=your_root_password_here
MYSQL_DATABASE=your_database_name_here
MYSQL_USER=your_user_here
MYSQL_PASSWORD=your_password_here

# JWT
JWT_SECRET=your-secret-key-change-in-production

# 2FA secret encryption (use a different random value in production)
TWO_FACTOR_ENCRYPTION_KEY=your-two-factor-encryption-key-change-in-production

# Public application URL (used in password reset links)
FRONTEND_URL=http://localhost:3000

# Local SMTP (replace these values with your provider credentials on the VPS)
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=EventManager <no-reply@eventmanager.local>

# Observabilité - Sentry (laisser vide pour désactiver en local)
SENTRY_DSN=
REACT_APP_SENTRY_DSN=
SENTRY_ENVIRONMENT=local
SENTRY_TRACES_SAMPLE_RATE=0.1
APP_VERSION=local
REACT_APP_VERSION=local

# Observabilité - Grafana
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me

# Analytique Matomo
MATOMO_DATABASE=matomo
MATOMO_DATABASE_USER=matomo
MATOMO_DATABASE_PASSWORD=change-me
MATOMO_DATABASE_ROOT_PASSWORD=change-me-root
REACT_APP_MATOMO_URL=http://localhost:8081
REACT_APP_MATOMO_SITE_ID=1
