{
  "annotations": { "list": [] },
  "editable": true,
  "graphTooltip": 1,
  "panels": [
    {
      "type": "stat",
      "title": "Backend disponible",
      "gridPos": { "h": 5, "w": 6, "x": 0, "y": 0 },
      "targets": [{ "expr": "up{job=\"eventmanager-backend\"}", "refId": "A" }]
    },
    {
      "type": "stat",
      "title": "MySQL disponible",
      "gridPos": { "h": 5, "w": 6, "x": 6, "y": 0 },
      "targets": [{ "expr": "eventmanager_database_up", "refId": "A" }]
    },
    {
      "type": "timeseries",
      "title": "Requêtes par seconde",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 5 },
      "targets": [{ "expr": "sum by (method) (rate(eventmanager_http_requests_total[5m]))", "legendFormat": "{{method}}", "refId": "A" }]
    },
    {
      "type": "timeseries",
      "title": "Latence HTTP p95",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 5 },
      "targets": [{ "expr": "histogram_quantile(0.95, sum by (le) (rate(eventmanager_http_request_duration_seconds_bucket[5m])))", "legendFormat": "p95", "refId": "A" }]
    },
    {
      "type": "timeseries",
      "title": "Réponses HTTP 5xx",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 13 },
      "targets": [{ "expr": "sum(rate(eventmanager_http_requests_total{status_code=~\"5..\"}[5m]))", "legendFormat": "5xx/s", "refId": "A" }]
    },
    {
      "type": "timeseries",
      "title": "Mémoire Node.js",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 13 },
      "targets": [{ "expr": "eventmanager_process_resident_memory_bytes", "legendFormat": "RSS", "refId": "A" }]
    }
  ],
  "refresh": "15s",
  "schemaVersion": 41,
  "tags": ["eventmanager", "backend"],
  "templating": { "list": [] },
  "time": { "from": "now-1h", "to": "now" },
  "timezone": "browser",
  "title": "EventManager - Vue d'ensemble",
  "uid": "eventmanager-overview",
  "version": 1
}
