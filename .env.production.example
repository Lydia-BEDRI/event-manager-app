# URL HTTPS publique
FRONTEND_URL=https://eventmanager.website
# Origines autorisées pour le site web et l'application Capacitor Android
ALLOWED_ORIGINS=https://eventmanager.website,http://localhost

# Base MySQL
MYSQL_ROOT_PASSWORD=CHANGE_ME_WITH_A_LONG_RANDOM_VALUE
MYSQL_USER=eventmanager
MYSQL_PASSWORD=CHANGE_ME_WITH_A_DIFFERENT_LONG_RANDOM_VALUE

# Secrets applicatifs distincts
JWT_SECRET=CHANGE_ME_WITH_A_RANDOM_SECRET
TWO_FACTOR_ENCRYPTION_KEY=CHANGE_ME_WITH_ANOTHER_RANDOM_SECRET
QR_CODE_PRIVATE_KEY=CHANGE_ME_WITH_ANOTHER_RANDOM_SECRET
JWT_EXPIRES_IN=15m
QR_CODE_TOKEN_TTL=365d

# Fournisseur SMTP réel 
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=CHANGE_ME
SMTP_PASSWORD=CHANGE_ME
SMTP_FROM=EventManager <no-reply@example.com>

# Signalement d'erreurs Sentry (laisser les DSN vides pour désactiver Sentry)
SENTRY_DSN=
REACT_APP_SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.1
APP_VERSION=production

# Accès administrateur Grafana
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_WITH_A_LONG_RANDOM_VALUE

# Base MariaDB dédiée à Matomo
MATOMO_DATABASE=matomo
MATOMO_DATABASE_USER=matomo
MATOMO_DATABASE_PASSWORD=CHANGE_ME_WITH_A_LONG_RANDOM_VALUE
MATOMO_DATABASE_ROOT_PASSWORD=CHANGE_ME_WITH_A_DIFFERENT_LONG_RANDOM_VALUE

# Analytique frontend (laisser l'URL vide tant que Matomo n'a pas d'URL HTTPS publique)
REACT_APP_MATOMO_URL=
REACT_APP_MATOMO_SITE_ID=1
