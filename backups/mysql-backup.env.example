# Copy this file on the VPS to:
# /home/ubuntu/secure-backups/env/mysql-backup.env
#
# Then edit the copy with real production values and keep chmod 600.
# Do not commit the real env file.

MYSQL_CONTAINER="eventmanager-production-db-1"
MYSQL_DATABASE="eventmanager"

# Prefer the MySQL root user for dumps so routines, triggers and events are exported.
# Use MYSQL_ROOT_PASSWORD from the production .env as MYSQL_PASSWORD.
MYSQL_USER="root"
MYSQL_PASSWORD="CHANGE_ME"

BACKUP_DIR="/home/ubuntu/secure-backups/mysql/eventmanager"
LOG_FILE="/home/ubuntu/secure-backups/mysql/backup.log"
LOCK_FILE="/tmp/eventmanager-mysql-backup.lock"

# rclone destination. Example: cloudflare-r2:event-manager-backups/mysql
# Leave empty only while testing local backups.
REMOTE_TARGET=""

RETENTION_LOCAL_DAYS=14
RETENTION_REMOTE_DAYS=60

# Optional webhook compatible with Discord, Slack or Uptime Kuma push wrappers.
# Leave empty to disable alerts.
ALERT_WEBHOOK_URL=""
