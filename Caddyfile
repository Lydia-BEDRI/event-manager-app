eventmanager.website {
	encode zstd gzip

	route {
		@metrics path /metrics /metrics/*
		respond @metrics 404

		handle /api/* {
			reverse_proxy backend:5000
		}

		handle /health {
			reverse_proxy backend:5000
		}

		handle /socket.io/* {
			reverse_proxy backend:5000
		}

		handle {
			reverse_proxy frontend:80
		}
	}
}
